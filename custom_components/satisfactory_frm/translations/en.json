{
  "config": {
    "step": {
      "user": {
        "title": "Add a Satisfactory server",
        "description": "Connect to a server running the Ficsit Remote Monitoring mod. The token is only needed for controlling switches and sending chat messages. Since Satisfactory 1.2 it's in FRM's in-game/server settings (older versions: Configs/FicsitRemoteMonitoring/WebServer.cfg).",
        "data": {
          "host": "Host",
          "port": "FRM port",
          "token": "FRM auth token",
          "name": "Display name"
        },
        "data_description": {
          "name": "Leave empty to use the current save name. Used as the device and entity name prefix and never changes automatically."
        }
      },
      "reconfigure": {
        "title": "Change server address",
        "data": {
          "host": "Host",
          "port": "FRM port"
        }
      }
    },
    "error": {
      "cannot_connect": "Can't reach FRM at that address. Check the host and port, and that the FRM web server is running.",
      "already_configured": "Another entry already uses this host and port.",
      "unknown": "FRM answered, but with something unexpected. Check the logs."
    },
    "abort": {
      "already_configured": "This server is already added.",
      "reconfigure_successful": "Server address updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Server options",
        "data": {
          "tracked_items": "Always track (all sensors)",
          "token": "FRM auth token",
          "chat_sender": "Chat sender name",
          "scan_interval": "Power and status refresh",
          "slow_interval": "Production refresh",
          "auto_track": "Auto-track produced items",
          "excluded_items": "Never track",
          "building_entities": "Create building entities"
        },
        "data_description": {
          "auto_track": "Creates net and efficiency sensors for every item your factory has machines making. New production lines are picked up automatically.",
          "tracked_items": "These items get all four sensors: produced, consumed, net and efficiency. Overrides Never track.",
          "excluded_items": "Skipped by auto-track. Useful for noisy intermediates you don't care about.",
          "building_entities": "A status sensor and a run/standby switch for every machine, extractor and generator, plus an \"All <recipe>\" switch per recipe. Switching needs the FRM token."
        }
      }
    }
  },
